# SQLAlchemy connection string — Supabase's pooled/pgbouncer transaction-mode
# connection string (port 6543). Used for all normal querying/schema reads.
# Local Postgres also works here for local-only development.
DATABASE_URL=postgresql://postgres.your_project_ref:your_password@aws-0-your-region.pooler.supabase.com:6543/postgres

# Used only for CREATE SCHEMA / CREATE TABLE / INSERT — schema provisioning on
# signup and dataset uploads. Must be Supabase's SESSION pooler connection
# string (same pooler hostname as DATABASE_URL, but port 5432, not the true
# "Direct connection" shown in the Supabase dashboard — that one is IPv6-only
# and unreachable from most cloud platforms). Falls back to DATABASE_URL if unset.
DATABASE_URL_DIRECT=postgresql://postgres.your_project_ref:your_password@aws-0-your-region.pooler.supabase.com:5432/postgres

# API key from console.groq.com
GROQ_API_KEY=gsk_your_key_here

# Groq model used for SQL/chart generation
MODEL_NAME=llama-3.3-70b-versatile

# Supabase project URL and anon/public key — Project Settings -> API in the
# Supabase dashboard. Different from DATABASE_URL/DATABASE_URL_DIRECT above
# (those are raw Postgres connection strings; these are used only for Auth —
# sign up / log in / sessions — via the supabase-py client).
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# For local development only, via python-dotenv (app/database/db.py calls
# load_dotenv()). On Streamlit Cloud, set these same six keys in the app's
# Secrets manager instead — see .streamlit/secrets.toml.example.
