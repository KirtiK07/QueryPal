# Copy this file to .streamlit/secrets.toml for local development, or paste
# these same four keys into the Streamlit Cloud app's Secrets manager
# (App settings -> Secrets) when deploying. streamlit_app.py copies these
# into os.environ on startup, so app/database/db.py's os.getenv() calls work
# unchanged either way.

DATABASE_URL = "postgresql://postgres.your_project_ref:your_password@aws-0-your-region.pooler.supabase.com:6543/postgres"
DATABASE_URL_DIRECT = "postgresql://postgres.your_project_ref:your_password@aws-0-your-region.pooler.supabase.com:5432/postgres"
GROQ_API_KEY = "gsk_your_key_here"
MODEL_NAME = "llama-3.3-70b-versatile"
